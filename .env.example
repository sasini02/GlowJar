# Copy to .env.local and fill in. Never commit real values.

# Public URL of the app, used to build magic-link and email links (e.g. http://localhost:3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL, from Project Settings > Data API (https://<project-ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...), from Project Settings > API Keys. Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...). Server only; bypasses RLS. Used for account deletion and admin tasks.
SUPABASE_SECRET_KEY=

# Resend API key for letter delivery and recap emails.
RESEND_API_KEY=

# Sender address for Resend emails, on a domain verified in Resend (e.g. "Glowjar <hello@yourdomain.com>").
RESEND_FROM_EMAIL=

# Web Push VAPID public key. Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Web Push VAPID private key. Server only.
VAPID_PRIVATE_KEY=

# Contact for push services, as a mailto: or https: URL.
VAPID_SUBJECT=

# Postgres connection string for npm run db:test, from the dashboard's Connect button > Session pooler. Includes the database password. Development project only.
SUPABASE_DB_URL=
