{
  "name": "glowjar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/build-tokens.mjs",
    "db:push": "supabase db push --remote",
    "db:push:seed": "supabase db push --remote --include-seed",
    "db:test": "node scripts/db-test.mjs",
    "db:test:docker": "supabase test db --remote",
    "db:types": "supabase gen types --lang=typescript --remote > src/lib/supabase/database.types.ts",
    "icons": "node scripts/build-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "supabase": "^3.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
