# Secrets for the Edge Functions. Copy to supabase/functions/.env, fill in, then run:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

# Shared secret pg_cron sends to send-cheerups and deliver-letters. Must match the Vault secret "cron_secret".
CRON_SECRET=

# Public URL of the app, used for links in letter emails (e.g. https://glowjar.app).
SITE_URL=

# Same VAPID pair as the app's .env.local (NEXT_PUBLIC_VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact for push services, as a mailto: or https: URL.
VAPID_SUBJECT=

# Resend API key and a sender on a domain verified in Resend, e.g. "Glowjar <letters@yourdomain.com>".
RESEND_API_KEY=
RESEND_FROM_EMAIL=
